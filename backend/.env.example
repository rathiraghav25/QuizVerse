PROJECT_NAME=QuizVerse API
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# Database Configuration (Neon PostgreSQL compatible connection string format)
# Development local SQLite fallback or PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-cool-name.us-east-1.aws.neon.tech/quizverse?sslmode=require
DATABASE_URL=sqlite:///./quizverse.db

# Security & CORS Settings
SECRET_KEY=supersecretkey_change_me_in_production_1234567890!@#$%
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
